# Copy to .env.local (gitignored) and fill in from the Supabase dashboard:
# Project Settings → API. Both values are public by design; the database's
# access rules protect the data. Leave them empty to run signed-out only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Daily reminders (docs/plans/notifications.md): the public VAPID key that
# scripts/notification-keys.mjs prints for this Supabase project. Public by
# design; its private half stays in the project's function secrets. Leave it
# empty to build without reminders.
VITE_VAPID_PUBLIC_KEY=

# Google Docs (docs/plans/google-docs.md): the OAuth client ID of the Google
# Cloud project used for sign-in, ending in .apps.googleusercontent.com.
# Public by design. Leave it empty to build without the Google Doc button.
VITE_GOOGLE_CLIENT_ID=
